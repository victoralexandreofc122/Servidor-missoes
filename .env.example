# =====================================================================
# Variáveis de ambiente do servidor-missoes
# No Render: Settings -> Environment -> Add Environment Variable (uma por uma).
# NUNCA coloque os valores reais neste arquivo nem no GitHub.
# =====================================================================

# Porta pública. O Render define PORT sozinho: NÃO crie essa variável lá.
PORT=3000

# Porta da API interna (só em 127.0.0.1, não fica exposta). Pode deixar o padrão.
INTERNAL_PORT=3001

# Connection string DIRETA do Neon (Connect -> "Connection pooling" DESLIGADO),
# com ?sslmode=require no fim. O host NÃO pode ter "-pooler".
DATABASE_URL=postgresql://usuario:senha@ep-exemplo-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Segredo dos JWT dos jogadores: 32+ caracteres aleatórios (gere, não invente).
JWT_SECRET=

# Token dos serviços internos: 32+ caracteres aleatórios, DIFERENTE do JWT_SECRET.
SERVICE_TOKEN=

# O Render fica atrás de proxy: true. Sem proxy na frente, use false.
TRUST_PROXY=true

# Origens de navegador permitidas (CSV, origem exata). Vazio = CORS desligado.
# O app mobile nativo não manda Origin: deixe vazio por enquanto.
ALLOWED_ORIGINS=

NODE_ENV=production

# Opcionais: se o emissor de tokens usar iss/aud, preencha os dois.
# JWT_ISSUER=nin-online-auth
# JWT_AUDIENCE=nin-online-game

# Opcionais: limites por IP + rota (padrões abaixo).
# RATE_LIMIT_GLOBAL_MAX=100
# RATE_LIMIT_SENSITIVE_MAX=10
# RATE_LIMIT_WINDOW_MS=60000

# Opcional: host da API pública (o Render exige 0.0.0.0, que já é o padrão).
# PUBLIC_HOST=0.0.0.0
# INTERNAL_HOST=127.0.0.1
